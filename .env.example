# ---- Database -------------------------------------------------------------
# Local development (SQLite, works out of the box):
DATABASE_URL="file:./dev.db"
# Production (Neon / Supabase / any PostgreSQL). The live app currently uses Neon:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require&channel_binding=require"

# ---- Sessions -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-in-production-please-use-a-long-random-string"

# ---- First admin (created by `npm run db:seed`) ---------------------------
ADMIN_EMAIL="admin@praticchabi.local"
ADMIN_PASSWORD="admin123"

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Uploads: local disk (dev) / Vercel Blob / S3-compatible --------------
# Leave BLOB and S3 empty to use local disk at .data/uploads (dev only).
BLOB_READ_WRITE_TOKEN=""
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT="https://..."
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# ---- Images: ImgBB (free public host for covers/gallery) ------------------
# Get a key at https://imgbb.com/api — DOCX submissions are never sent here.
IMGBB_API_KEY=""

# ---- Email: Brevo (Sendinblue). Empty = log to console/EmailLog -----------
# Verify the EMAIL_FROM sender in Brevo before sending live mail.
BREVO_API_KEY=""
EMAIL_FROM="Praticchabi <noreply@praticchabi.local>"
NOTIFY_EMAIL="praticchabi.iiuc@gmail.com"
